{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/shared/components/*"
      ],
      "@features/*": [
        "src/features/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@utils/*": [
        "src/shared/utils/*"
      ],
      "@api/*": [
        "src/api/*"
      ],
      "@store/*": [
        "src/store/*"
      ],
      "@data/*": [
        "src/data/*"
      ],
      "@util/*": [
        "src/util/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}